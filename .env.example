# Google Places API (New). Required for Google Maps links, Google photos and reviews.
# Enable "Places API (New)" in Google Cloud and restrict the key to that API.
GOOGLE_PLACES_API_KEY=

# Optional. Pexels API key for licensed stock hero video and decorative images.
PEXELS_API_KEY=

# Protects the whole app (generator + previews) with HTTP basic auth.
# Leave empty only for local development.
GENERATOR_USER=solulab
GENERATOR_PASSWORD=
